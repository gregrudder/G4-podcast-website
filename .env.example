# Copy to .env.local for local development. Never commit real keys.
# On Vercel, set these in Project → Settings → Environment Variables.

# Resend. Leave RESEND_API_KEY and RESEND_FROM_EMAIL empty to keep the
# contact form on its email fallback (visitors are told to email
# info@g4-marketing.net). Do not send from @g4podcast.net — that domain
# has no mail setup. Verify the from-address domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_TO_EMAIL=info@g4-marketing.net

# Google Analytics 4. Leave blank to disable. The tag loads only after
# the visitor accepts analytics on the cookie banner.
# The previous GoDaddy site used a measurement ID that still needs
# confirmation of ownership before it is reused. See TODO.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Web Analytics. Set to true to load @vercel/analytics.
# Leave false or unset to disable.
NEXT_PUBLIC_VERCEL_ANALYTICS=
